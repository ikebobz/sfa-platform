# Server
# NODE_ENV: docker-compose.yml overrides this to "production" for the api
# container regardless of what's set here (see the comment in that file) — this
# value only applies when running `npm run dev` directly on your own machine,
# outside Docker.
NODE_ENV=development
PORT=4000

# Database (MariaDB)
# DB_HOST=127.0.0.1 is correct for `npm run dev` on your own machine talking to
# a locally-installed or port-forwarded MariaDB. Inside docker-compose, the api
# container instead talks to the `mariadb` service by its service name — that
# override lives in docker-compose.yml itself, not here.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sfa_user
DB_PASSWORD=change_me
DB_NAME=sfa_platform

# Root password for the MariaDB container itself (used only to initialize it on
# first start via docker-compose — the app connects with DB_USER/DB_PASSWORD
# above, not this). Not used at all if you're running MariaDB outside Docker.
MYSQL_ROOT_PASSWORD=change_me_too

# Auth
JWT_ACCESS_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_too_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — set this to your actual deployed web app URL in production
# (e.g. https://app.yourdomain.com), not localhost.
CORS_ORIGIN=http://localhost:5173
