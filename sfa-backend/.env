# Server
NODE_ENV=development
PORT=4000

# Database (MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sfa_user
DB_PASSWORD=change_me
DB_NAME=sfa_platform

# Auth
